# Cross-Service Call Chain: Fraud Detection Flow
# Payment triggers AI fraud scoring, blocks suspicious transactions
# Chain Length: 5 services, 3 languages

@contract
feature_id: "ECP-CHAIN-FRAUD-DETECTION-FLOW"
owner: "Leo Rivera <leo.rivera@ecp.dev>"
team: "platform"
classification: "internal"
approvers: ["leo.rivera@ecp.dev"]
retention_years: 7
timeout_ms: 15000
@end

@link payment-service-java::fraud_score_compute as fraud_score_compute
@link ai-service-python::fraud_detect_transaction as fraud_detect_transaction
@link auth-service-java::audit_login_failure as audit_login_failure
@link notification-node::slack_channel_notify as slack_channel_notify
@link analytics-java::realtime_metric_alert as realtime_metric_alert

@java[step_0_fraud_score_compute]
# Step 1: payment-service-java -> fraud_score_compute
# Language: java
# This is step 1 of 5 in the Fraud Detection Flow call chain.
def process(req):
    return {"step": 1, "service": "payment-service-java", "action": "fraud_score_compute", "status": "completed"}
@end
@python[step_1_fraud_detect_transaction]
