def process(req):
    return {"step": 4, "service": "notification-node", "action": "slack_channel_notify", "status": "completed"}
@end
@java[step_4_realtime_metric_alert]
# Step 5: analytics-java -> realtime_metric_alert
# Language: java
# This is step 5 of 5 in the Fraud Detection Flow call chain.
def process(req):
    return {"step": 5, "service": "analytics-java", "action": "realtime_metric_alert", "status": "completed"}
@end

@merge strategy="all-success" order=["java", "python", "java", "javascript", "java"]
@end

@rationale for="fraud_detection_flow"
reason: "This call chain crosses 3 language boundaries. Each step is isolated in its own process cell for fault tolerance."
@end

@decision for="fraud_detection_flow"
decision: "Route through API Gateway for centralized auth and rate limiting"
date: "2024-03-20"
status: "accepted"
@end

@audit
action: "Trace full call chain execution for Fraud Detection Flow"
fields: ["chain_id", "total_steps", "total_latency_ms", "failed_steps"]
