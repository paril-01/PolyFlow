# Cross-Service Call Chain: Customer Purchase Flow
# Customer adds items to cart, checks out, payment processed, notifications sent
# Chain Length: 9 services, 5 languages

@contract
feature_id: "ECP-CHAIN-CUSTOMER-PURCHASE-FLOW"
