# Cross-Service Call Chain: Ai Search Flow
# Customer searches for a product using natural language, AI processes query
# Chain Length: 6 services, 4 languages

@contract
feature_id: "ECP-CHAIN-AI-SEARCH-FLOW"
owner: "Jake Thompson <jake.thompson@ecp.dev>"
team: "platform"
classification: "internal"
approvers: ["jake.thompson@ecp.dev"]
retention_years: 7
timeout_ms: 15000
@end

@link frontend-react::search_autocomplete as search_autocomplete
@link gateway-go::route_search as route_search
@link ai-service-python::semantic_search_query as semantic_search_query
@link recommendation-python::similar_products_fetch as similar_products_fetch
@link pricing-python::price_base_set as price_base_set
@link analytics-java::event_track as event_track

