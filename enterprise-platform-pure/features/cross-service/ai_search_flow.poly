@merge strategy="all-success" order=["typescript", "go", "python", "python", "python", "java"]
@end

@rationale for="ai_search_flow"
reason: "This call chain crosses 4 language boundaries. Each step is isolated in its own process cell for fault tolerance."
@end

@decision for="ai_search_flow"
decision: "Route through API Gateway for centralized auth and rate limiting"
date: "2024-03-20"
status: "accepted"
@end

@audit
action: "Trace full call chain execution for Ai Search Flow"
fields: ["chain_id", "total_steps", "total_latency_ms", "failed_steps"]
