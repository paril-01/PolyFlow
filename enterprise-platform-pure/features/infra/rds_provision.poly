# Rds Provision — PolyFlow Governance Module
# Service: terraform | Language: hcl | Domain: infrastructure

@contract
feature_id: "ECP-INFRASTRUCTURE-RDS-PROVISION"
owner: "Iris Nakamura <iris.nakamura@ecp.dev>"
team: "platform"
classification: "sensitive"
approvers: ["iris.nakamura@ecp.dev", "grace.liu@ecp.dev"]
retention_years: 7
timeout_ms: 5000
@end

@schema RdsProvisionRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema RdsProvisionResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="hcl"
allowed_imports: ["json"]
@end

@hcl[service]
// Rds Provision implementation
@end

@merge strategy="first-success" order=["hcl"]
@end

@error-map language="hcl"
  "Error" -> "Unknown error in rds_provision."
@end

@rationale for="rds_provision"
reason: "Selected hcl for Rds Provision due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="rds_provision"
decision: "Implement as microservice endpoint on terraform"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Iris Nakamura"]
@end

@audit
action: "Log Rds Provision execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
