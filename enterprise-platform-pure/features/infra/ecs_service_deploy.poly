# Ecs Service Deploy — PolyFlow Governance Module
# Service: terraform | Language: hcl | Domain: infrastructure

@contract
feature_id: "ECP-INFRASTRUCTURE-ECS-SERVICE-DEPLOY"
owner: "Leo Rivera <leo.rivera@ecp.dev>"
team: "backend"
classification: "public"
approvers: ["leo.rivera@ecp.dev"]
retention_years: 7
timeout_ms: 5000
@end

@schema EcsServiceDeployRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema EcsServiceDeployResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="hcl"
allowed_imports: ["json"]
@end

@hcl[service]
// Ecs Service Deploy implementation
@end

@merge strategy="fallback" order=["hcl"]
@end

@error-map language="hcl"
  "Error" -> "Unknown error in ecs_service_deploy."
@end

@rationale for="ecs_service_deploy"
reason: "Selected hcl for Ecs Service Deploy due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="ecs_service_deploy"
decision: "Implement as microservice endpoint on terraform"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Leo Rivera"]
@end

@audit
action: "Log Ecs Service Deploy execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
