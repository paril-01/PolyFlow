# Elasticache Provision — PolyFlow Governance Module
# Service: terraform | Language: hcl | Domain: infrastructure

@contract
feature_id: "ECP-INFRASTRUCTURE-ELASTICACHE-PROVISIO"
owner: "David Kim <david.kim@ecp.dev>"
team: "backend"
classification: "sensitive"
approvers: ["david.kim@ecp.dev", "david.kim@ecp.dev"]
retention_years: 7
timeout_ms: 3000
@end

@schema ElasticacheProvisionRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ElasticacheProvisionResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="hcl"
allowed_imports: ["json"]
@end

@hcl[service]
// Elasticache Provision implementation
@end

@merge strategy="vote" order=["hcl"]
@end

@error-map language="hcl"
  "Error" -> "Unknown error in elasticache_provision."
@end

@rationale for="elasticache_provision"
reason: "Selected hcl for Elasticache Provision due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="elasticache_provision"
decision: "Implement as microservice endpoint on terraform"
date: "2024-06-15"
status: "accepted"
stakeholders: ["David Kim"]
@end

@audit
action: "Log Elasticache Provision execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
