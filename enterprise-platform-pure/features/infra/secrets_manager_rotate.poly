# Secrets Manager Rotate — PolyFlow Governance Module
# Service: terraform | Language: hcl | Domain: infrastructure

@contract
feature_id: "ECP-INFRASTRUCTURE-SECRETS-MANAGER-ROTA"
owner: "Hassan Ali <hassan.ali@ecp.dev>"
team: "backend"
classification: "sensitive"
approvers: ["hassan.ali@ecp.dev", "hassan.ali@ecp.dev"]
retention_years: 7
timeout_ms: 2000
@end

@schema SecretsManagerRotateRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema SecretsManagerRotateResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="hcl"
allowed_imports: ["json"]
@end

@hcl[service]
// Secrets Manager Rotate implementation
@end

@merge strategy="first-success" order=["hcl"]
@end

@error-map language="hcl"
  "Error" -> "Unknown error in secrets_manager_rotate."
@end

@rationale for="secrets_manager_rotate"
reason: "Selected hcl for Secrets Manager Rotate due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="secrets_manager_rotate"
decision: "Implement as microservice endpoint on terraform"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Hassan Ali"]
@end

@audit
action: "Log Secrets Manager Rotate execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
