# Review Create — PolyFlow Governance Module
# Service: frontend-react | Language: typescript | Domain: frontend_customer

@contract
feature_id: "ECP-FRONTEND_CUSTOMER-REVIEW-CREATE"
owner: "Iris Nakamura <iris.nakamura@ecp.dev>"
team: "platform"
classification: "internal"
approvers: ["iris.nakamura@ecp.dev"]
retention_years: 7
timeout_ms: 5000
@end

@schema ReviewCreateRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ReviewCreateResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface ReviewCreateProps {
  onComplete?: (data: any) => void;
}

export const ReviewCreate: React.FC<ReviewCreateProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/frontend_customer/review-create', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Review Create'}
    </button>
  );
};
@end

@merge strategy="vote" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in review_create component."
  "NetworkError" -> "API call failed for review_create."
@end

@rationale for="review_create"
reason: "Selected typescript for Review Create due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="review_create"
decision: "Implement as microservice endpoint on frontend-react"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Iris Nakamura"]
@end

@audit
action: "Log Review Create execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
