# Order Tracking View — PolyFlow Governance Module
# Service: frontend-react | Language: typescript | Domain: frontend_customer

@contract
feature_id: "ECP-FRONTEND_CUSTOMER-ORDER-TRACKING-VIEW"
owner: "Hassan Ali <hassan.ali@ecp.dev>"
team: "backend"
classification: "internal"
approvers: ["hassan.ali@ecp.dev"]
retention_years: 7
timeout_ms: 2000
@end

@schema OrderTrackingViewRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  items: array<OrderItem>
  total: number<min:0>
  metadata: object | null
@end

@schema OrderTrackingViewResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface OrderTrackingViewProps {
  onComplete?: (data: any) => void;
}

export const OrderTrackingView: React.FC<OrderTrackingViewProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/frontend_customer/order-tracking-view', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Order Tracking View'}
    </button>
  );
};
@end

@merge strategy="vote" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in order_tracking_view component."
  "NetworkError" -> "API call failed for order_tracking_view."
@end

@rationale for="order_tracking_view"
reason: "Selected typescript for Order Tracking View due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="order_tracking_view"
decision: "Implement as microservice endpoint on frontend-react"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Hassan Ali"]
@end

@audit
action: "Log Order Tracking View execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
