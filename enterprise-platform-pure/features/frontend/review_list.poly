# Review List — PolyFlow Governance Module
# Service: frontend-react | Language: typescript | Domain: frontend_customer

@contract
feature_id: "ECP-FRONTEND_CUSTOMER-REVIEW-LIST"
owner: "Frank Johnson <frank.johnson@ecp.dev>"
team: "devops"
classification: "sensitive"
approvers: ["frank.johnson@ecp.dev", "david.kim@ecp.dev"]
retention_years: 7
timeout_ms: 8000
@end

@schema ReviewListRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ReviewListResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface ReviewListProps {
  onComplete?: (data: any) => void;
}

export const ReviewList: React.FC<ReviewListProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/frontend_customer/review-list', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Review List'}
    </button>
  );
};
@end

@merge strategy="fallback" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in review_list component."
  "NetworkError" -> "API call failed for review_list."
@end

@rationale for="review_list"
reason: "Selected typescript for Review List due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="review_list"
decision: "Implement as microservice endpoint on frontend-react"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Frank Johnson"]
@end

@audit
action: "Log Review List execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
