# Product Image Gallery — PolyFlow Governance Module
# Service: frontend-react | Language: typescript | Domain: frontend_customer

@contract
feature_id: "ECP-FRONTEND_CUSTOMER-PRODUCT-IMAGE-GALLER"
owner: "Carol Williams <carol.williams@ecp.dev>"
team: "frontend"
classification: "restricted"
approvers: ["carol.williams@ecp.dev", "grace.liu@ecp.dev"]
retention_years: 7
timeout_ms: 3000
@end

@schema ProductImageGalleryRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ProductImageGalleryResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface ProductImageGalleryProps {
  onComplete?: (data: any) => void;
}

export const ProductImageGallery: React.FC<ProductImageGalleryProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/frontend_customer/product-image-gallery', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Product Image Gallery'}
    </button>
  );
};
@end

@merge strategy="vote" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in product_image_gallery component."
  "NetworkError" -> "API call failed for product_image_gallery."
@end

@rationale for="product_image_gallery"
reason: "Selected typescript for Product Image Gallery due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="product_image_gallery"
decision: "Implement as microservice endpoint on frontend-react"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Carol Williams"]
@end

@audit
action: "Log Product Image Gallery execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
