# User List — PolyFlow Governance Module
# Service: frontend-angular | Language: typescript | Domain: admin

@contract
feature_id: "ECP-ADMIN-USER-LIST"
owner: "Karen Singh <karen.singh@ecp.dev>"
team: "ml"
classification: "restricted"
approvers: ["karen.singh@ecp.dev", "david.kim@ecp.dev"]
retention_years: 7
timeout_ms: 8000
@end

@schema UserListRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema UserListResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface UserListProps {
  onComplete?: (data: any) => void;
}

export const UserList: React.FC<UserListProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/admin/user-list', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'User List'}
    </button>
  );
};
@end

@merge strategy="first-success" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in user_list component."
  "NetworkError" -> "API call failed for user_list."
@end

@rationale for="user_list"
reason: "Selected typescript for User List due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="user_list"
decision: "Implement as microservice endpoint on frontend-angular"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Karen Singh"]
@end

@audit
action: "Log User List execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
