# Api Key Admin Revoke — PolyFlow Governance Module
# Service: frontend-angular | Language: typescript | Domain: admin

@contract
feature_id: "ECP-ADMIN-API-KEY-ADMIN-REVOKE"
owner: "Grace Liu <grace.liu@ecp.dev>"
team: "frontend"
classification: "public"
approvers: ["grace.liu@ecp.dev"]
retention_years: 7
timeout_ms: 2000
@end

@schema ApiKeyAdminRevokeRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ApiKeyAdminRevokeResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface ApiKeyAdminRevokeProps {
  onComplete?: (data: any) => void;
}

export const ApiKeyAdminRevoke: React.FC<ApiKeyAdminRevokeProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/admin/api-key-admin-revoke', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Api Key Admin Revoke'}
    </button>
  );
};
@end

@merge strategy="first-success" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in api_key_admin_revoke component."
  "NetworkError" -> "API call failed for api_key_admin_revoke."
@end

@rationale for="api_key_admin_revoke"
reason: "Selected typescript for Api Key Admin Revoke due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="api_key_admin_revoke"
decision: "Implement as microservice endpoint on frontend-angular"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Grace Liu"]
@end

@audit
action: "Log Api Key Admin Revoke execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
