# Whatsapp Template — PolyFlow Governance Module
# Service: notification-node | Language: javascript | Domain: notifications

@contract
feature_id: "ECP-NOTIFICATIONS-WHATSAPP-TEMPLATE"
owner: "David Kim <david.kim@ecp.dev>"
team: "backend"
classification: "sensitive"
approvers: ["david.kim@ecp.dev", "hassan.ali@ecp.dev"]
retention_years: 7
timeout_ms: 2000
@end

@schema WhatsappTemplateRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema WhatsappTemplateResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="javascript"
allowed_imports: ["express", "uuid", "winston", "bull", "nodemailer"]
@end

@javascript[service]
const { v4: uuidv4 } = require('uuid');

async function process(req) {
  const start = Date.now();
  const traceId = uuidv4().slice(0, 8);

  const result = {
    feature: 'whatsapp_template',
    domain: 'notifications',
    processed: true,
    input_keys: Object.keys(req || {}),
  };

  return {
    status: 'success',
    trace_id: traceId,
    result,
    processing_time_ms: Date.now() - start,
  };
}

module.exports = { process };
@end

@merge strategy="all-success" order=["javascript"]
@end

@error-map language="javascript"
  "TypeError" -> "Type mismatch in whatsapp_template payload."
  "ECONNREFUSED" -> "Downstream service unreachable from whatsapp_template."
@end

@rationale for="whatsapp_template"
reason: "Selected javascript for Whatsapp Template due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="whatsapp_template"
decision: "Implement as microservice endpoint on notification-node"
date: "2024-06-15"
status: "accepted"
stakeholders: ["David Kim"]
@end

@audit
action: "Log Whatsapp Template execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
