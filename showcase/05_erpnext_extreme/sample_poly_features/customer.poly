@contract
feature_id: ERPNEXT_SELLING-CUSTOMER
owner: selling-engineering
classification: enterprise
is_submittable: false
timeout_ms: 3000
@end

@schema Customer
  overview_tab: string
  overview_html: string
  details_tab: string
  basic_info: string
  naming_series: string
  customer_name: string
  gender: link<Gender>
  customer_type: string
  default_bank_account: link<Bank Account>
  lead_name: link<Lead>
  image: string
  column_break0: string
  account_manager: link<User>
  customer_group: link<Customer Group>
  territory: link<Territory>
  tax_id: string
  tax_category: link<Tax Category>
  disabled: string
  is_internal_customer: string
  represents_company: link<Company>
  companies: table<Allowed To Transact With>
  default_currency: link<Currency>
  default_price_list: link<Price List>
  language: link<Language>
  address_contacts: string
@end

