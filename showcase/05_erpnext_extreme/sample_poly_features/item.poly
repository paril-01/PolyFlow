@contract
feature_id: ERPNEXT_STOCK-ITEM
owner: stock-engineering
classification: enterprise
is_submittable: false
timeout_ms: 3000
@end

@schema Item
  naming_series: string
  item_code: string
  variant_of: link<Item>
  item_name: string
  item_group: link<Item Group>
  stock_uom: link<UOM>
  column_break0: string
  disabled: string
  allow_alternative_item: string
  is_stock_item: string
  include_item_in_manufacturing: string
  opening_stock: string
  valuation_rate: string
  standard_rate: string
  is_fixed_asset: string
  asset_category: link<Asset Category>
  asset_naming_series: string
  image: string
  section_break_11: string
  brand: link<Brand>
  description: string
  sb_barcodes: string
  barcodes: table<Item Barcode>
  inventory_section: string
  shelf_life_in_days: string
@end

