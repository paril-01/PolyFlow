# PolyFlow Executable Vertical Slice: Selling (Sales Invoice Taxes & Totals Calculation)
# Derived from native ERPNext Accounts & Selling controller logic

@contract
feature_id: ERPNEXT-SELLING-SALES-INVOICE-CALCULATION
owner: selling-engineering
classification: enterprise
is_submittable: true
timeout_ms: 5000
@end

@schema SalesInvoiceItem
  item_code: string
  qty: float
  rate: float
  discount_percentage: float
  tax_rate: float
@end

@schema SalesInvoiceTotals
  net_total: float
  total_discount: float
  total_taxes: float
  grand_total: float
  rounded_total: float
@end

