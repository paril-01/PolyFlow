# Weather & Environment — PolyFlow Governance Module

@contract
feature_id: "urbanos-weather-environment"
owner: "UrbanOS Env Team"
team: "environment"
domain: "weather"
timeout_ms: 10000
@end

@python[weather_and_air_processor]
import time, math, random

def process(req):
    lat = req.get("lat", 40.7128)
    lon = req.get("lon", -74.0060)

    temp_c = round(random.gauss(28, 5), 1)
    humidity = round(random.gauss(62, 15), 1)
    wind_kmh = round(abs(random.gauss(12, 8)), 1)
    rain_mm = round(max(0, random.gauss(-2, 5)), 1)
    visibility_km = round(max(0.5, random.gauss(10, 3)), 1)
    pressure_hpa = round(random.gauss(1013, 8), 1)
    cloud_cover = min(100, max(0, int(random.gauss(45, 25))))

    if rain_mm > 5:
        condition = "HEAVY_RAIN"
    elif rain_mm > 1:
        condition = "LIGHT_RAIN"
    elif cloud_cover > 80:
        condition = "OVERCAST"
    elif cloud_cover > 40:
        condition = "PARTLY_CLOUDY"
    elif visibility_km < 2:
        condition = "FOG"
    else:
        condition = "CLEAR"

    pm25 = round(max(5, random.gauss(35, 20)), 1)
    pm10 = round(max(8, random.gauss(55, 25)), 1)
    no2 = round(max(2, random.gauss(28, 12)), 1)
    o3 = round(max(5, random.gauss(42, 15)), 1)

    if pm25 <= 12:
        aqi = int(pm25 * 50 / 12)
    elif pm25 <= 35.4:
        aqi = int(50 + (pm25 - 12) * 50 / 23.4)
    elif pm25 <= 55.4:
        aqi = int(100 + (pm25 - 35.4) * 50 / 20)
    else:
        aqi = int(150 + (pm25 - 55.4) * 50 / 25)

    impact = 0.0
    if condition == "HEAVY_RAIN":
        impact = 0.35
    elif condition == "LIGHT_RAIN":
        impact = 0.15
    elif condition == "FOG":
        impact = 0.25
    elif wind_kmh > 40:
        impact = 0.10
    
    if temp_c > 40 or temp_c < -5:
        impact += 0.08

    return {
        "temperature_c": temp_c,
        "humidity_pct": humidity,
        "wind_speed_kmh": wind_kmh,
        "rain_mm": rain_mm,
        "visibility_km": visibility_km,
        "pressure_hpa": pressure_hpa,
        "cloud_cover_pct": cloud_cover,
        "weather_condition": condition,
        "pm25": pm25,
        "pm10": pm10,
        "no2": no2,
        "o3": o3,
        "aqi": aqi,
        "aqi_category": "Good" if aqi <= 50 else ("Moderate" if aqi <= 100 else ("Unhealthy-SG" if aqi <= 150 else "Unhealthy")),
        "weather_traffic_impact_pct": round(impact * 100, 1),
        "predicted_speed_reduction_pct": round(impact * 18, 1),
        "predicted_travel_time_increase_pct": round(impact * 14, 1),
        "source": "OPEN_METEO + WAQI",
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "confidence": round(0.85 + random.random() * 0.12, 2),
        "status": "live"
    }
@end

@merge strategy="vote" order=["python"]
@end

@audit
action: "Log Weather & Air Reading"
retention: "365_days"
compliance: ["EPA_AQI_STANDARD"]
@end
