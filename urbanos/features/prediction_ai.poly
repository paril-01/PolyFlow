# Prediction AI — PolyFlow Governance Module

@contract
feature_id: "urbanos-prediction-ai"
owner: "UrbanOS AI Team"
team: "ai"
domain: "ai"
timeout_ms: 8000
@end

@python[prediction_engine]
import time, math, random

def process(req):
    speed = req.get("current_speed", 28.0)
    volume = req.get("current_volume", 1200)
    weather = req.get("weather_condition", "CLEAR")
    hour = req.get("time_of_day", 12)
    incidents = req.get("incidents_active", 0)

    base_congestion = max(0, 1.0 - speed / 45.0)
    
    rush_factor = 0.0
    if 7 <= hour <= 9:
        rush_factor = 0.15
    elif 16 <= hour <= 18:
        rush_factor = 0.20

    weather_factors = {
        "CLEAR": 0, "PARTLY_CLOUDY": 0, "OVERCAST": 0.02,
        "LIGHT_RAIN": 0.08, "HEAVY_RAIN": 0.18,
        "FOG": 0.12, "SNOW": 0.25, "ICE": 0.35
    }
    wx = weather_factors.get(weather, 0)

    forecast_15 = min(1.0, base_congestion + rush_factor * 0.5 + wx + random.gauss(0, 0.03))
    forecast_30 = min(1.0, base_congestion + rush_factor + wx * 1.2 + random.gauss(0, 0.05))
    forecast_60 = min(1.0, base_congestion + rush_factor * 0.8 + wx * 0.8 + random.gauss(0, 0.07))

    speed_variance = abs(random.gauss(0, 5))
    inc_base = 0.02 + (speed_variance / 100) + (wx * 0.3) + (incidents * 0.01)
    inc_prob = min(0.95, max(0.01, inc_base + random.gauss(0, 0.01)))

    tt_impact = round((forecast_30 * 35 + wx * 20) + random.gauss(0, 2), 1)
    tt_impact = max(0, tt_impact)

    speed_dev = abs(speed - 28) / 28
    vol_dev = abs(volume - 1200) / 1200
    anomaly = round(0.4 * speed_dev + 0.3 * vol_dev + 0.3 * inc_prob, 3)

    n_affected = int(forecast_30 * 12 + random.gauss(0, 1))
    n_affected = max(0, min(12, n_affected))

    return {
        "congestion_forecast_15min": round(forecast_15, 3),
        "congestion_forecast_30min": round(forecast_30, 3),
        "congestion_forecast_60min": round(forecast_60, 3),
        "incident_probability": round(inc_prob, 3),
        "travel_time_impact_pct": tt_impact,
        "affected_corridors": n_affected,
        "anomaly_score": anomaly,
        "predicted_speed_reduction_pct": round(forecast_30 * 18, 1),
        "model_confidence": round(0.82 + random.random() * 0.15, 2),
        "models_used": ["LSTM-CongestionNet", "XGBoost-IncidentPredictor", "WeatherCorrelation-v2"],
        "inference_ms": round(random.gauss(12, 3), 1),
        "source": "URBANOS_AI_ENGINE",
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "status": "predicted"
    }
@end

@merge strategy="vote" order=["python"]
@end

@audit
action: "Log AI Prediction"
retention: "90_days"
compliance: ["AI_EXPLAINABILITY_STD"]
@end
