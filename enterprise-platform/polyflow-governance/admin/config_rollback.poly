# Config Rollback — PolyFlow Governance Module
# Service: frontend-angular | Language: typescript | Domain: admin

@contract
feature_id: "ECP-ADMIN-CONFIG-ROLLBACK"
owner: "Frank Johnson <frank.johnson@ecp.dev>"
team: "devops"
classification: "restricted"
approvers: ["frank.johnson@ecp.dev", "alice.chen@ecp.dev"]
retention_years: 7
timeout_ms: 8000
@end

@schema ConfigRollbackRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema ConfigRollbackResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface ConfigRollbackProps {
  onComplete?: (data: any) => void;
}

export const ConfigRollback: React.FC<ConfigRollbackProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/admin/config-rollback', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Config Rollback'}
    </button>
  );
};
@end

@merge strategy="vote" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in config_rollback component."
  "NetworkError" -> "API call failed for config_rollback."
@end

@rationale for="config_rollback"
reason: "Selected typescript for Config Rollback due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="config_rollback"
decision: "Implement as microservice endpoint on frontend-angular"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Frank Johnson"]
@end

@audit
action: "Log Config Rollback execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
