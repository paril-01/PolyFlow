# Checkout Shipping — PolyFlow Governance Module
# Service: frontend-react | Language: typescript | Domain: frontend_customer

@contract
feature_id: "ECP-FRONTEND_CUSTOMER-CHECKOUT-SHIPPING"
owner: "Bob Martinez <bob.martinez@ecp.dev>"
team: "backend"
classification: "internal"
approvers: ["bob.martinez@ecp.dev"]
retention_years: 7
timeout_ms: 8000
@end

@schema CheckoutShippingRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema CheckoutShippingResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="typescript"
allowed_imports: ["react", "axios", "@tanstack/react-query"]
@end

@typescript[service]
import React, { useState } from 'react';

interface CheckoutShippingProps {
  onComplete?: (data: any) => void;
}

export const CheckoutShipping: React.FC<CheckoutShippingProps> = ({ onComplete }) => {
  const [loading, setLoading] = useState(false);

  const handleClick = async () => {
    setLoading(true);
    try {
      const res = await fetch('/api/v1/frontend_customer/checkout-shipping', { method: 'POST' });
      const data = await res.json();
      onComplete?.(data);
    } finally {
      setLoading(false);
    }
  };

  return (
    <button onClick={handleClick} disabled={loading}>
      {loading ? 'Processing...' : 'Checkout Shipping'}
    </button>
  );
};
@end

@merge strategy="all-success" order=["typescript"]
@end

@error-map language="typescript"
  "TypeError" -> "Type mismatch in checkout_shipping component."
  "NetworkError" -> "API call failed for checkout_shipping."
@end

@rationale for="checkout_shipping"
reason: "Selected typescript for Checkout Shipping due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="checkout_shipping"
decision: "Implement as microservice endpoint on frontend-react"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Bob Martinez"]
@end

@audit
action: "Log Checkout Shipping execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
