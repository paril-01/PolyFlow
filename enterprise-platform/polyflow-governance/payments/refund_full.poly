# Refund Full — PolyFlow Governance Module
# Service: payment-service-java | Language: java | Domain: payments

@contract
feature_id: "ECP-PAYMENTS-REFUND-FULL"
owner: "Carol Williams <carol.williams@ecp.dev>"
team: "frontend"
classification: "sensitive"
approvers: ["carol.williams@ecp.dev", "leo.rivera@ecp.dev"]
retention_years: 7
timeout_ms: 8000
@end

@schema RefundFullRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema RefundFullResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="java"
allowed_imports: ["java.util", "java.time", "org.springframework", "javax.persistence"]
@end

@java[service]
package com.ecp.service;

import java.util.*;

public class RefundFullProcessor {
    public Map<String, Object> process(Map<String, Object> req) {
        long start = System.currentTimeMillis();
        Map<String, Object> result = Map.of(
            "feature", "refund_full",
            "domain", "payments",
            "processed", true
        );
        long elapsed = System.currentTimeMillis() - start;
        return Map.of(
            "status", "success",
            "result", result,
            "processing_time_ms", elapsed
        );
    }
}
@end

@merge strategy="vote" order=["java"]
@end

@error-map language="java"
  "NullPointerException" -> "Required field is missing in refund_full request."
  "IllegalArgumentException" -> "Invalid argument passed to refund_full."
  "TimeoutException" -> "Operation refund_full timed out."
@end

@rationale for="refund_full"
reason: "Selected java for Refund Full due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="refund_full"
decision: "Implement as microservice endpoint on payment-service-java"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Carol Williams"]
@end

@audit
action: "Log Refund Full execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
