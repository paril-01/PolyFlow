# Cross-Service Call Chain: Order Return Flow
# Customer initiates a return, inventory restocked, refund processed
# Chain Length: 7 services, 5 languages

@contract
feature_id: "ECP-CHAIN-ORDER-RETURN-FLOW"
owner: "Iris Nakamura <iris.nakamura@ecp.dev>"
team: "platform"
classification: "internal"
approvers: ["iris.nakamura@ecp.dev"]
retention_years: 7
timeout_ms: 15000
@end

@link frontend-react::order_history_detail as order_history_detail
@link gateway-go::route_order_return as route_order_return
@link order-service-go::order_return_request as order_return_request
@link inventory-python::reservation_release as reservation_release
@link payment-service-java::refund_full as refund_full
@link notification-node::email_send as email_send
@link analytics-java::event_track as event_track

@typescript[step_0_order_history_detail]
# Step 1: frontend-react -> order_history_detail
# Language: typescript
# This is step 1 of 7 in the Order Return Flow call chain.
def process(req):
    return {"step": 1, "service": "frontend-react", "action": "order_history_detail", "status": "completed"}
@end
