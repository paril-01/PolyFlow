# Step 5: payment-service-java -> refund_full
# Language: java
# This is step 5 of 7 in the Order Return Flow call chain.
def process(req):
    return {"step": 5, "service": "payment-service-java", "action": "refund_full", "status": "completed"}
@end
@javascript[step_5_email_send]
# Step 6: notification-node -> email_send
# Language: javascript
# This is step 6 of 7 in the Order Return Flow call chain.
def process(req):
    return {"step": 6, "service": "notification-node", "action": "email_send", "status": "completed"}
@end
@java[step_6_event_track]
# Step 7: analytics-java -> event_track
