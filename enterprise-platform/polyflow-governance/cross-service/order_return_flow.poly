@merge strategy="all-success" order=["typescript", "go", "go", "python", "java", "javascript", "java"]
@end

@rationale for="order_return_flow"
reason: "This call chain crosses 5 language boundaries. Each step is isolated in its own process cell for fault tolerance."
@end

@decision for="order_return_flow"
decision: "Route through API Gateway for centralized auth and rate limiting"
date: "2024-03-20"
status: "accepted"
@end

@audit
action: "Trace full call chain execution for Order Return Flow"
fields: ["chain_id", "total_steps", "total_latency_ms", "failed_steps"]
retention: "7_years"
compliance: ["SOC2"]
@end
