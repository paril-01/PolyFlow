# Vpc Create — PolyFlow Governance Module
# Service: terraform | Language: hcl | Domain: infrastructure

@contract
feature_id: "ECP-INFRASTRUCTURE-VPC-CREATE"
owner: "Bob Martinez <bob.martinez@ecp.dev>"
team: "backend"
classification: "restricted"
approvers: ["bob.martinez@ecp.dev", "iris.nakamura@ecp.dev"]
retention_years: 7
timeout_ms: 2000
@end

@schema VpcCreateRequest
  id: string<format:uuid>
  timestamp: string<format:datetime>
  metadata: object | null
@end

@schema VpcCreateResponse
  id: string<format:uuid>
  status: string
  processing_time_ms: number
  result: object | null
  errors: array<string>
@end

@standard language="hcl"
allowed_imports: ["json"]
@end

@hcl[service]
// Vpc Create implementation
@end

@merge strategy="fallback" order=["hcl"]
@end

@error-map language="hcl"
  "Error" -> "Unknown error in vpc_create."
@end

@rationale for="vpc_create"
reason: "Selected hcl for Vpc Create due to ecosystem maturity and team expertise."
alternatives_considered: ["rust", "elixir"]
rejected_reasons: {"rust": "Team lacks Rust experience", "elixir": "Insufficient library support"}
@end

@decision for="vpc_create"
decision: "Implement as microservice endpoint on terraform"
date: "2024-06-15"
status: "accepted"
stakeholders: ["Bob Martinez"]
@end

@audit
action: "Log Vpc Create execution"
fields: ["status", "trace_id", "processing_time_ms"]
retention: "7_years"
compliance: ["SOC2", "PCI-DSS"]
@end
