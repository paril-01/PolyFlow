# 01_auth_identity.poly — PolyFinTech Authentication & OAuth2 PKCE Module

@contract
feature_id: "FINTECH-AUTH-001"
owner: "fintech-identity-group"
classification: "sensitive"
approvers: ["ciso@polyfintech.com", "compliance@polyfintech.com"]
retention_years: 7
timeout_ms: 3000
@end

@schema AuthLoginRequest
  username: string<format:email>
  password: string<min:8,max:128>
  mfa_code: string | null
@end

@schema AuthLoginResponse
  user_id: string
  access_token: string
  role: string
  status: string
@end

@standard language="python"
allowed_imports: ["json", "hashlib", "time", "sqlite3", "sys"]
@end

@typescript[component]
import React, { useState } from 'react';

export function AuthPortalForm({ onLoginSuccess }: { onLoginSuccess: (user: any) => void }) {
  const [email, setEmail] = useState('executive@enterprise.com');
  const [password, setPassword] = useState('Password123!');
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    const res = await fetch('/api/v1/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username: email, password }),
    });
    const data = await res.json();
    setLoading(false);
    if (res.ok) onLoginSuccess(data);
  };

  return (
    <div className="bg-slate-900 border border-slate-800 p-8 rounded-2xl max-w-md mx-auto text-white shadow-2xl">
      <h2 className="text-2xl font-bold text-white">PolyFinTech Portal Authentication</h2>
      <form onSubmit={handleSubmit} className="mt-6 space-y-4">
        <div>
          <label className="block text-xs uppercase text-slate-400 font-bold">Email</label>
          <input
            type="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white font-mono text-sm"
          />
        </div>
        <div>
          <label className="block text-xs uppercase text-slate-400 font-bold">Password</label>
          <input
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            className="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white font-mono text-sm"
          />
        </div>
        <button
          type="submit"
          disabled={loading}
          className="w-full bg-indigo-600 hover:bg-indigo-500 py-3 rounded-xl font-bold text-sm text-white shadow-lg"
        >
          {loading ? 'Authenticating...' : 'Sign In to Corporate Treasury'}
        </button>
      </form>
    </div>
  );
}
@end

@python[service]
def process(req):
    username = req.get("username", "executive@enterprise.com")
    password = req.get("password", "Password123!")
    
    pass_hash = hashlib.sha256(password.encode()).hexdigest()
    user_id = "usr_corp_101"
    
    token = f"eyJhbGciOiJIUzI1NiJ9.{user_id}.{hashlib.sha256((username + str(time.time())).encode()).hexdigest()[:24]}"
    
    ctx.emit_audit("auth_login_successful", user_id=user_id, username=username)
    
    return {
        "status": "authenticated",
        "user_id": user_id,
        "username": username,
        "role": "cfo",
        "company_name": "PolyFinTech Global Corp",
        "full_name": "Alexander Vance",
        "access_token": token,
        "expires_in": 3600
    }
@end

@java[backend]
package com.polyfintech.auth;

import java.util.Map;

public class JavaSamlAuthenticator {
    public Map<String, Object> validateSamlSession(String username) {
        return Map.of(
            "status", "SAML_ASSERTION_VALIDATED",
            "issuer", "https://sso.polyfintech.com/idp",
            "mfa_verified", true
        );
    }
}
@end

@merge strategy="fallback" order=["python", "java"]
@end
