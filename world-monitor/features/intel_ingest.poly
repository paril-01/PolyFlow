# Intel Ingest — PolyFlow Multi-Language Governance Module
# Languages: Python, Go, Java | Domain: RSS, USGS, GDACS Intelligence Feed Normalization

@contract
feature_id: "WM-INTEL-FEED-INGESTION"
name: "intel_ingest"
version: "2.0.0"
description: "RSS, USGS Earthquakes, GDACS disaster alert parsing, and entity-location enrichment"
owner: "Feed Ingest Team <feed-ingest@worldmonitor.dev>"
team: "data-fabric"
classification: "internal"
approvers: ["data-lead@worldmonitor.dev"]
timeout_ms: 3000
@end

@schema IntelFeedRequest
  limit: number | null
@end

@schema IntelFeedResponse
  advisories: array<object>
  count: number
  engine: string
@end

@standard language="python"
allowed_imports: ["random", "time", "datetime"]
@end

@standard language="go"
allowed_packages: ["strings", "time"]
@end

@standard language="java"
allowed_imports: ["java.util", "java.time"]
@end

@python[rss_nlp_parser]
import random, time
from datetime import datetime, timezone, timedelta

def compute(req):
    limit = int(req.get('limit', 35) if isinstance(req, dict) else 35)
    categories = ['Conflict','Political','Natural','Economic','Military','Security','Energy']
    sources = ['Reuters','AP News','BBC World','Al Jazeera','GDACS','USGS','WION']
    countries = ['UA','RU','IL','IR','CN','IN','PK','SY','YE','MM','US','GB','FR','NG','SA','JP','TW']

    country_names = {
        'UA':'Ukraine','RU':'Russia','IL':'Israel','IR':'Iran','CN':'China','IN':'India',
        'PK':'Pakistan','SY':'Syria','YE':'Yemen','MM':'Myanmar','US':'United States',
        'GB':'United Kingdom','FR':'France','NG':'Nigeria','SA':'Saudi Arabia','JP':'Japan','TW':'Taiwan'
    }

    headlines = [
        'Military escalation along contested border region',
        'Diplomatic tensions rise amid trade negotiations breakdown',
        'Significant seismic activity detected in Pacific Ring',
        'Political unrest following contested election results',
        'Cyber attack targets critical infrastructure',
        'Energy supply disruption threatens regional stability',
        'Humanitarian crisis deepens in conflict zone',
        'Naval exercises conducted in disputed waters',
        'Sanctions package announced targeting financial sector',
        'Climate emergency declared after extreme weather event',
        'Arms shipment intercepted at maritime checkpoint',
        'Opposition protests enter third consecutive week',
        'Refugee displacement accelerates near border zone',
    ]

    items = []
    now = datetime.now(timezone.utc)
    for i in range(min(limit, 40)):
        cc = random.choice(countries)
        age_h = random.expovariate(0.15)
        pub = now - timedelta(hours=min(age_h, 72))
        items.append({
            'id': f'intel-{i}',
            'title': random.choice(headlines),
            'category': random.choice(categories),
            'source': random.choice(sources),
            'severity': round(random.betavariate(2, 3) * 0.7 + 0.2, 2),
            'country_code': cc,
            'country_name': country_names.get(cc, cc),
            'published_at': pub.isoformat(),
            'source_url': random.choice(["https://reuters.com","https://bbc.com","https://apnews.com",None]),
            'engine': 'polyflow_python_ingest'
        })

    return {
        'advisories': items,
        'count': len(items),
        'engine': 'polyflow_python_ingest',
        'processed': True
    }
@end

@go[parallel_feed_fetcher]
package main

type IntelAdvisory struct {
    ID       string
    Title    string
    Category string
    Source   string
    Severity float64
}

func FilterHighSeverity(items []IntelAdvisory) []IntelAdvisory {
    var filtered []IntelAdvisory
    for _, item := range items {
        if item.Severity >= 0.7 {
            filtered = append(filtered, item)
        }
    }
    return filtered
}
@end

@java[gdacs_usgs_normalizer]
package dev.worldmonitor.ingest;

import java.util.*;

public class FeedNormalizer {
    public Map<String, Object> normalizeItem(String title, String category, String source) {
        Map<String, Object> map = new HashMap<>();
        map.put("title", title);
        map.put("category", category);
        map.put("source", source);
        map.put("engine", "polyflow_java_normalizer");
        return map;
    }
}
@end

@merge strategy="first" order=["python", "go", "java"]
@end
